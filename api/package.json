{
  "name": "@slaylist/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "seed": "node scripts/seed-songs.mjs",
    "backup": "node scripts/backup-songs-table.mjs",
    "restore": "node scripts/restore-songs-table.mjs",
    "prestart": "node -e \"const fs=require('fs');if(!fs.existsSync('local.settings.json')){fs.copyFileSync('local.settings.json.example','local.settings.json');console.log('Created local.settings.json from .example template')}\"",
    "start": "func start"
  },
  "dependencies": {
    "@azure/data-tables": "13.3.2",
    "@azure/functions": "4.16.0",
    "@azure/storage-blob": "12.34.0",
    "jose": "6.2.15"
  },
  "devDependencies": {
    "@slaylist/shared": "workspace:*"
  }
}
